<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof isAdmin !== 'undefined' && isAdmin ? 'Super Admin Login' : 'Sign In' %> - EcoSuite Ops</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 flex items-center justify-center min-h-screen px-4 py-12">

    <!-- Global Loading Overlay -->
    <div id="loading-overlay" class="fixed inset-0 bg-white/80 backdrop-blur-sm z-50 flex-col items-center justify-center hidden">
        <div class="w-12 h-12 border-4 border-blue-200 border-t-blue-600 rounded-full animate-spin mb-4"></div>
        <p class="text-sm font-semibold text-slate-700">Authenticating credentials...</p>
    </div>

    <div class="max-w-md w-full space-y-6 bg-white p-8 rounded-2xl border border-slate-200 shadow-xl">
        <div class="text-center">
            <a href="/" class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
                EcoSuite Ops
            </a>
            <h2 class="mt-3 text-2xl font-bold text-slate-900">
                <%= typeof isAdmin !== 'undefined' && isAdmin ? 'Super Admin Portal' : 'Sign In to Your Workspace' %>
            </h2>
            <p class="mt-1 text-sm text-slate-500">
                <%= typeof isAdmin !== 'undefined' && isAdmin ? 'System Administration & Master Access' : 'Access your organization microservices portal' %>
            </p>
        </div>

        <% if (error) { %>
            <div class="p-3 bg-red-50 border border-red-200 text-red-600 text-sm rounded-lg text-center font-medium">
                <%= error %>
            </div>
        <% } %>

        <form id="login-form" action="<%= typeof isAdmin !== 'undefined' && isAdmin ? '/super-admin/login' : '/api/auth/login' %>" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Work Email</label>
                <input type="email" name="email" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:border-blue-600 focus:bg-white focus:outline-none text-sm transition">
            </div>

            <div>
                <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Password</label>
                <input type="password" name="password" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:border-blue-600 focus:bg-white focus:outline-none text-sm transition">
            </div>

            <button type="submit" id="submit-btn" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-lg shadow-blue-600/20 transition">
                Sign In
            </button>
        </form>

        <% if (typeof isAdmin === 'undefined' || !isAdmin) { %>
            <p class="text-center text-xs text-slate-500">
                Don't have an account? <a href="/signup" class="text-blue-600 hover:underline font-semibold">Start 14-Day Free Trial</a>
            </p>
        <% } %>
    </div>

    <script>
        document.getElementById('login-form').addEventListener('submit', function() {
            const overlay = document.getElementById('loading-overlay');
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            document.getElementById('submit-btn').disabled = true;
        });
    </script>
</body>
</html>