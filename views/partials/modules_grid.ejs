<section id="modules" class="py-20 px-6 max-w-7xl mx-auto">
    <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-white">Modular Business Architecture</h2>
        <p class="text-gray-400 mt-2">Each module operates independently with dedicated databases while connecting under one master suite.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <% modules.forEach(mod => { %>
            <div class="p-6 bg-gray-800/50 border border-gray-700/60 rounded-xl hover:border-blue-500/50 transition">
                <span class="text-xs px-2.5 py-1 bg-blue-900/40 text-blue-300 rounded border border-blue-800/50 mb-4 inline-block">
                    <%= mod.badge_tag %>
                </span>
                <h3 class="text-lg font-semibold text-white mb-2"><%= mod.module_title %></h3>
                <p class="text-sm text-gray-400"><%= mod.short_description %></p>
            </div>
        <% }) %>
    </div>
</section>