<section id="pricing" class="py-20 px-6 bg-gray-950 border-t border-gray-800">
    <div class="max-w-5xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Start Free, Scale as You Grow</h2>
        <p class="text-gray-400 mb-12">Try all core modules for 14 days without restriction. Super Admin customizes access post-trial.</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-left max-w-4xl mx-auto">
            <% plans.forEach(plan => { %>
                <div class="p-8 rounded-2xl border <%= plan.is_popular ? 'border-blue-500 bg-gray-900 shadow-xl shadow-blue-500/10' : 'border-gray-800 bg-gray-900/40' %> flex flex-col justify-between">
                    <div>
                        <% if (plan.is_popular) { %>
                            <span class="px-3 py-1 text-xs uppercase font-bold text-blue-400 bg-blue-950 border border-blue-800 rounded-full inline-block mb-3">
                                Recommended
                            </span>
                        <% } %>
                        <h3 class="text-xl font-bold text-white"><%= plan.plan_name %></h3>
                        <div class="mt-4 mb-6">
                            <span class="text-4xl font-extrabold text-white">
                                <%= plan.price_monthly == 0 ? 'Free' : '$' + plan.price_monthly %>
                            </span>
                            <span class="text-gray-400 text-sm"><%= plan.price_monthly == 0 ? ' for 14 days' : '/month' %></span>
                        </div>
                        <ul class="space-y-3 mb-8 text-sm text-gray-300">
                            <% plan.features_list.forEach(feat => { %>
                                <li class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-blue-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                    <%= feat %>
                                </li>
                            <% }) %>
                        </ul>
                    </div>
                    <a href="/signup" class="w-full text-center py-3 font-semibold rounded-lg <%= plan.is_popular ? 'bg-blue-600 hover:bg-blue-500 text-white' : 'bg-gray-800 hover:bg-gray-700 text-white border border-gray-700' %> transition">
                        <%= plan.price_monthly == 0 ? 'Start Free Trial' : 'Contact Super Admin' %>
                    </a>
                </div>
            <% }) %>
        </div>
    </div>
</section>